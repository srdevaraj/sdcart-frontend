[TEMPLATE]
# sdCart Frontend — environment variable template
#
# Copy this file to `.env` and fill in values for your environment.
# NEVER commit real credentials or production URLs in source code.
# (`.env` is git-ignored; commit only this template.)
#
# Expo inlines EXPO_PUBLIC_* variables at build time. After changing this
# file, restart the Metro bundler (`npx expo start -c`) with a clean cache.

# Backend API base URL.
#
# The default (when this variable is absent) is the deployed Render backend:
#   https://sdcart-demo-backend.onrender.com
#
# For LOCAL development against the Spring Boot backend (docker compose up in
# the backend directory) override it with:
#   EXPO_PUBLIC_API_URL=http://localhost:8080
#
# WARNING: a physical phone cannot reach localhost/127.0.0.1. Keep the
# Render URL for device testing unless you explicitly want the local backend.
EXPO_PUBLIC_API_URL=https://sdcart-demo-backend.onrender.com
